# User data — saved layouts live in ~/.config/monitor-layouts, never in the repo
*.json
!extension/**/metadata.json

# Install backups created by install.sh
*.bak.*

# Compiled GSettings schema (generated by glib-compile-schemas at install time)
gschemas.compiled

# Compiled translations (generated by msgfmt at install time from po/*.po)
*.mo
extension/**/locale/

# Editor / OS noise
*.swp
*~
.DS_Store
__pycache__/

# Local-only assistant notes — never publish
CLAUDE.md
COMMIT.md
