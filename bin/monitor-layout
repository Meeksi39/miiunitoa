#!/usr/bin/env python3
"""monitor-layout — save and switch GNOME (Wayland/mutter) monitor layouts.

Talks to org.gnome.Mutter.DisplayConfig over D-Bus, so it works live on
GNOME Wayland where xrandr / wlr-randr / autorandr do not.

Usage:
  monitor-layout save <name>          Save the current monitor layout under <name>
  monitor-layout apply <name>         Switch to the saved layout <name>
  monitor-layout list                 List saved layouts
  monitor-layout current              Show the current layout (as it would be saved)
  monitor-layout rename <old> <new>   Rename a saved layout
  monitor-layout delete <name>        Delete a saved layout
  monitor-layout active               Print the saved layout matching the current config
  monitor-layout match [--apply] [--prefer <name>]
                                      Find/apply the saved layout matching connected monitors
                                      (remaps onto renamed connectors by EDID identity)
"""

import json
import os
import sys

# PyGObject is only needed for the live D-Bus calls. Importing it lazily keeps
# the pure layout logic (ordering, matching, duplicate detection) importable —
# and therefore unit-testable — on machines without GNOME / PyGObject.
try:
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
except (ImportError, ValueError):  # pragma: no cover - exercised only off-GNOME
    Gio = GLib = None

PROFILE_DIR = os.path.expanduser("~/.config/monitor-layouts")

# ApplyMonitorsConfig methods
METHOD_VERIFY = 0
METHOD_TEMPORARY = 1
METHOD_PERSISTENT = 2

TRANSFORMS = {
    0: "normal", 1: "90", 2: "180", 3: "270",
    4: "flipped", 5: "flipped-90", 6: "flipped-180", 7: "flipped-270",
}


def proxy():
    return Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None,
        "org.gnome.Mutter.DisplayConfig",
        "/org/gnome/Mutter/DisplayConfig",
        "org.gnome.Mutter.DisplayConfig", None,
    )


def get_current_state(p):
    res = p.call_sync("GetCurrentState", None, Gio.DBusCallFlags.NONE, -1, None)
    serial, monitors, logical_monitors, props = res.unpack()
    return serial, monitors, logical_monitors, props


def current_mode_by_connector(monitors):
    """Map connector -> current mode id (the active resolution/refresh)."""
    out = {}
    for spec, modes, _mprops in monitors:
        connector = spec[0]
        chosen = None
        for mode in modes:
            mode_id, w, h, refresh, pref_scale, scales, mprops = mode
            if mprops.get("is-current"):
                chosen = mode_id
                break
        if chosen is None and modes:
            chosen = modes[0][0]  # fall back to first/preferred
        out[connector] = chosen
    return out


def connectors_current(monitors):
    """Set of connectors currently connected (from GetCurrentState)."""
    return {spec[0] for spec, _modes, _mprops in monitors}


def connectors_of(profile):
    """Set of connectors a saved layout references."""
    return {
        m["connector"]
        for lm in profile["logical_monitors"]
        for m in lm["monitors"]
    }


def canonical_lms(lms):
    """Order logical monitors deterministically: primary first, then top-to-bottom,
    left-to-right. Mutter assigns monitor index 0 to the first entry, and a lot of
    window-placement / fullscreen fallback logic targets monitor 0 — so the primary
    must lead, otherwise fullscreen apps land on whatever happens to be first
    (e.g. a rotated secondary screen). Sorting also makes two layouts that differ
    only in capture order compare equal."""
    return sorted(
        lms,
        key=lambda lm: (not lm.get("primary"), lm["y"], lm["x"]),
    )


def normalized(profile):
    """Profile reduced to a canonical, comparable form: JSON round-trip (so tuples
    vs lists and int vs float don't matter) plus canonical monitor ordering. Used
    for equality checks so an already-active layout isn't needlessly re-applied —
    re-applying re-emits MonitorsChanged and would loop on hotplug."""
    p = json.loads(json.dumps(profile))
    p["logical_monitors"] = canonical_lms(p.get("logical_monitors", []))
    # EDID identity is advisory metadata for remapping, not part of a layout's
    # identity — drop it so a layout saved before this field existed still
    # compares equal to a fresh capture (otherwise `active`/no-op checks break).
    for lm in p["logical_monitors"]:
        for m in lm.get("monitors", []):
            for key in ("vendor", "product", "serial"):
                m.pop(key, None)
    return p


def capture_from(monitors, logical_monitors):
    """Pure transform of a GetCurrentState reply into a serializable layout.
    Kept free of D-Bus so it can be unit-tested with recorded fixtures."""
    mode_for = current_mode_by_connector(monitors)

    lms = []
    for x, y, scale, transform, primary, lm_monitors, _lprops in logical_monitors:
        mons = []
        for spec in lm_monitors:
            connector = spec[0]
            mon = {"connector": connector, "mode_id": mode_for.get(connector)}
            # Record the EDID identity (vendor, product, serial) so `match` can
            # remap this layout onto renamed connectors later — e.g. a DisplayPort
            # MST dock that reshuffles DP-N names across dock/undock.
            if len(spec) >= 4:
                mon["vendor"], mon["product"], mon["serial"] = spec[1], spec[2], spec[3]
            mons.append(mon)
        lms.append({
            "x": x, "y": y, "scale": scale,
            "transform": transform, "primary": primary,
            "monitors": mons,
        })
    return {"logical_monitors": canonical_lms(lms)}


def identity_groups(monitors):
    """Map each monitor identity (vendor, product, serial) -> [connectors].
    A GetCurrentState monitor is (spec, modes, props) with
    spec = (connector, vendor, product, serial)."""
    groups = {}
    for spec, _modes, _mprops in monitors:
        connector, vendor, product, serial = spec
        groups.setdefault((vendor, product, serial), []).append(connector)
    return groups


def duplicate_identity_warning(monitors):
    """Warn when monitors share an identical EDID identity. GNOME/mutter identify
    monitors by vendor+product+serial, so identical ones (e.g. cheap panels that
    all report serial 0x00000000) can only be told apart by connector name — which
    is not stable across reboots/hotplug. Returns a message, or None if all unique."""
    dups = {ident: conns for ident, conns in identity_groups(monitors).items()
            if len(conns) > 1}
    if not dups:
        return None
    lines = ["Warning: these monitors are indistinguishable by EDID, so layouts can",
             "only be matched by connector name (which may change across reboots):"]
    for (vendor, product, serial), conns in sorted(dups.items()):
        lines.append(f"  {vendor} {product} serial={serial}: {', '.join(sorted(conns))}")
    return "\n".join(lines)


def capture():
    """Return a serializable description of the current layout."""
    p = proxy()
    _serial, monitors, logical_monitors, _props = get_current_state(p)
    return capture_from(monitors, logical_monitors)


def describe(profile):
    lines = []
    for lm in profile["logical_monitors"]:
        conns = ", ".join(
            f"{m['connector']}@{m['mode_id']}" for m in lm["monitors"]
        )
        flags = []
        if lm["primary"]:
            flags.append("primary")
        if lm["transform"]:
            flags.append(f"rot:{TRANSFORMS.get(lm['transform'], lm['transform'])}")
        flag = f" [{', '.join(flags)}]" if flags else ""
        lines.append(
            f"  ({lm['x']},{lm['y']}) scale={lm['scale']:g} {conns}{flag}"
        )
    return "\n".join(lines)


def path_for(name):
    return os.path.join(PROFILE_DIR, f"{name}.json")


def cmd_save(name):
    p = proxy()
    _serial, monitors, logical_monitors, _props = get_current_state(p)
    profile = capture_from(monitors, logical_monitors)
    os.makedirs(PROFILE_DIR, exist_ok=True)
    with open(path_for(name), "w") as f:
        json.dump(profile, f, indent=2)
    print(f"Saved layout '{name}':")
    print(describe(profile))
    warning = duplicate_identity_warning(monitors)
    if warning:
        print(warning, file=sys.stderr)


def load_profile(name):
    path = path_for(name)
    if not os.path.exists(path):
        sys.exit(f"No saved layout named '{name}'. Try: monitor-layout list")
    with open(path) as f:
        return json.load(f)


def apply_profile(name, profile):
    """Apply a loaded layout via ApplyMonitorsConfig (PERSISTENT)."""
    p = proxy()
    serial, _monitors, _lms, _props = get_current_state(p)

    logical_monitors = []
    for lm in canonical_lms(profile["logical_monitors"]):
        mons = [(m["connector"], m["mode_id"], {}) for m in lm["monitors"]]
        logical_monitors.append(
            (lm["x"], lm["y"], float(lm["scale"]),
             lm["transform"], lm["primary"], mons)
        )

    args = GLib.Variant(
        "(uua(iiduba(ssa{sv}))a{sv})",
        (serial, METHOD_PERSISTENT, logical_monitors, {}),
    )
    try:
        p.call_sync("ApplyMonitorsConfig", args, Gio.DBusCallFlags.NONE, -1, None)
    except GLib.Error as e:
        sys.exit(f"Failed to apply '{name}': {e.message}\n"
                 f"(The saved connectors/modes may not match what's plugged in now.)")


def cmd_apply(name):
    apply_profile(name, load_profile(name))
    print(f"Applied layout '{name}'.")


def saved_names():
    if not os.path.isdir(PROFILE_DIR):
        return []
    return sorted(f[:-5] for f in os.listdir(PROFILE_DIR) if f.endswith(".json"))


def cmd_list():
    names = saved_names()
    if not names:
        print("No saved layouts yet.")
        return
    for name in names:
        print(f"* {name}")
        with open(path_for(name)) as f:
            print(describe(json.load(f)))


def cmd_current():
    print(describe(capture()))


def cmd_delete(name):
    path = path_for(name)
    if not os.path.exists(path):
        sys.exit(f"No saved layout named '{name}'.")
    os.remove(path)
    print(f"Deleted layout '{name}'.")


def cmd_rename(old, new):
    if not os.path.exists(path_for(old)):
        sys.exit(f"No saved layout named '{old}'.")
    if os.path.exists(path_for(new)):
        sys.exit(f"A layout named '{new}' already exists.")
    os.rename(path_for(old), path_for(new))
    print(f"Renamed layout '{old}' -> '{new}'.")


def cmd_active():
    """Print the saved layout whose config equals the current one (else nothing)."""
    # normalized() handles JSON tuple/float quirks *and* monitor ordering, so a
    # layout saved before primary-first ordering still matches its live config.
    current = normalized(capture())
    for name in saved_names():
        if normalized(load_profile(name)) == current:
            print(name)
            return


def identity_of_entry(m):
    """EDID identity stored on a saved monitor entry, or None for layouts saved
    before identities were recorded (those can only be matched by connector)."""
    if all(k in m for k in ("vendor", "product", "serial")):
        return (m["vendor"], m["product"], m["serial"])
    return None


def remap_connectors(profile, monitors):
    """If a layout's connectors aren't all present (e.g. an MST dock renamed
    DP-3/4/5 to DP-6/7/8), try to remap it onto the connected monitors by EDID
    identity — and, within a group of identical monitors, by sorted connector
    order so the physical daisy-chain order is preserved. Returns a remapped
    copy, or None if it can't be covered (a pre-identity layout, or too few
    connected monitors of some identity)."""
    present = {}
    for spec, _modes, _mprops in monitors:
        connector, vendor, product, serial = spec
        present.setdefault((vendor, product, serial), []).append(connector)
    for conns in present.values():
        conns.sort()

    required = {}
    for lm in profile["logical_monitors"]:
        for m in lm["monitors"]:
            ident = identity_of_entry(m)
            if ident is None:
                return None  # pre-identity layout — re-save it to enable remap
            required.setdefault(ident, []).append(m["connector"])

    mapping = {}
    for ident, old_conns in required.items():
        avail = present.get(ident, [])
        if len(old_conns) > len(avail):
            return None  # not enough connected monitors of this identity
        for old, new in zip(sorted(old_conns), avail):
            mapping[old] = new

    remapped = json.loads(json.dumps(profile))
    for lm in remapped["logical_monitors"]:
        for m in lm["monitors"]:
            m["connector"] = mapping[m["connector"]]
    return remapped


def applicable_profile(profile, monitors):
    """The profile to apply for the connected monitors: the profile itself when
    all its connectors are present, otherwise a connector-remapped copy, else
    None."""
    wanted = connectors_of(profile)
    if wanted and wanted <= connectors_current(monitors):
        return profile
    return remap_connectors(profile, monitors)


def usable_layouts(monitors):
    """[(name, profile_to_apply)] for every saved layout applicable to the
    connected monitors (exact connectors or remapped), largest first."""
    out = []
    for name in saved_names():
        prof = load_profile(name)
        applicable = applicable_profile(prof, monitors)
        if applicable is not None:
            out.append((name, applicable, len(connectors_of(prof))))
    out.sort(key=lambda t: (-t[2], t[0]))
    return [(n, ap) for n, ap, _ in out]


def remap_summary(saved, applied):
    """'DP-3->DP-6, DP-5->DP-8' describing which connectors a remap changed.
    `saved` and `applied` share geometry, so canonical order lines them up."""
    old = [m["connector"] for lm in canonical_lms(saved["logical_monitors"])
           for m in lm["monitors"]]
    new = [m["connector"] for lm in canonical_lms(applied["logical_monitors"])
           for m in lm["monitors"]]
    moves = [f"{o}->{n}" for o, n in zip(old, new) if o != n]
    return ", ".join(moves)


def cmd_match(apply, prefer):
    """Find/apply the saved layout matching the connected monitors."""
    p = proxy()
    _serial, monitors, _lms, _props = get_current_state(p)
    usable = usable_layouts(monitors)
    names = [n for n, _ in usable]

    if not apply:
        for name in names:
            print(name)
        return

    if not usable:
        sys.exit("No saved layout matches the connected monitors.")
    if prefer and prefer in names:
        chosen, profile = next((n, ap) for n, ap in usable if n == prefer)
    else:
        # Prefer the layout that uses the most monitors; ambiguous only on a tie.
        top_size = len(connectors_of(load_profile(names[0])))
        top = [n for n in names
               if len(connectors_of(load_profile(n))) == top_size]
        if len(top) > 1:
            sys.exit(f"Ambiguous: several layouts match ({', '.join(top)}). "
                     f"Disambiguate with --prefer <name>.")
        chosen, profile = usable[0]

    # Skip the apply if it would be a no-op. Applying re-emits MonitorsChanged,
    # so re-applying the already-active layout would loop endlessly on hotplug.
    if normalized(profile) == normalized(capture()):
        print(f"Layout '{chosen}' is already active.")
        return

    # If we remapped onto renamed connectors, say so on stderr — the extension
    # only surfaces stderr on failure, so it stays quiet, but a CLI user sees it.
    saved = load_profile(chosen)
    if connectors_of(saved) != connectors_of(profile):
        print(f"Remapped '{chosen}' onto current connectors "
              f"({remap_summary(saved, profile)}).", file=sys.stderr)

    apply_profile(chosen, profile)
    print(f"Applied layout '{chosen}'.")


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return
    cmd = argv[1]
    rest = argv[2:]
    arg = rest[0] if rest else None
    if cmd == "save" and arg:
        cmd_save(arg)
    elif cmd == "apply" and arg:
        cmd_apply(arg)
    elif cmd == "list":
        cmd_list()
    elif cmd == "current":
        cmd_current()
    elif cmd == "rename" and len(rest) == 2:
        cmd_rename(rest[0], rest[1])
    elif cmd == "delete" and arg:
        cmd_delete(arg)
    elif cmd == "active":
        cmd_active()
    elif cmd == "match":
        apply = "--apply" in rest
        prefer = None
        if "--prefer" in rest:
            i = rest.index("--prefer")
            if i + 1 < len(rest):
                prefer = rest[i + 1]
        cmd_match(apply, prefer)
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv)
